DATABASE_URL=postgresql+psycopg://ajocircle:ajocircle@db:5432/ajocircle
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITATION_EXPIRE_HOURS=168
NOTIFICATION_PROVIDER=LOG
CORS_ORIGINS=http://localhost:3000

# Phone verification is disabled until Firebase Authentication is configured.
APP_ENVIRONMENT=development
PHONE_VERIFICATION_PROVIDER=DISABLED
FIREBASE_PROJECT_ID=
# Per-account and per-phone hourly request limit; resend cooldown remains 60 seconds.
PHONE_VERIFICATION_REQUESTS_PER_HOUR=5
# GOOGLE_APPLICATION_CREDENTIALS=/app/.env.firebase-service-account.json
